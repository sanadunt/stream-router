# Konfigurasi Docker Compose Camera Integration (stream-router).
# Salin menjadi .env di folder yang sama dengan docker-compose.yml (windows\setup.ps1 melakukannya
# otomatis). Jangan commit atau membagikan file .env.
#
# Format: KEY=nilai tanpa spasi di sekitar "=". Karakter $ pada nilai dibaca Docker Compose sebagai
# variabel; bungkus nilai dengan tanda kutip tunggal bila mengandung $, mis. ADMIN_PASSWORD='pa$$word'.

# Password awal role admin dan operator: wajib, minimal 8 karakter, bukan nilai contoh. Hanya dipakai
# saat database pertama kali dibuat; setelah itu ubah melalui Settings → Keamanan Akun.
ADMIN_PASSWORD=
OPERATOR_PASSWORD=

# IP LAN komputer host (Windows), mis. 192.168.1.10. Dipakai sebagai host publik MediaMTX/WebRTC dan
# alamat dashboard dari perangkat lain: http://<HOST_LAN_IP>:3000. Tanpa nilai ini WebRTC dari host
# lain di LAN tidak dapat tersambung, karena container hanya melihat IP jaringan internal Docker.
HOST_LAN_IP=

# Zona waktu container (nama folder/file recording dan waktu log).
TZ=Asia/Jakarta

# Alamat host tempat port dipublikasikan. 0.0.0.0 = semua interface (dapat diakses dari LAN);
# 127.0.0.1 = hanya dari komputer ini.
BIND_ADDRESS=0.0.0.0

# Opsional: image lain, mis. versi tertentu. Default ghcr.io/sanadunt/stream-router:latest
# (paket release sudah mengunci versinya di docker-compose.yml).
# STREAM_ROUTER_IMAGE=ghcr.io/sanadunt/stream-router:1.0.0

# Opsional: biarkan kosong agar dibuat otomatis sekali lalu disimpan di volume data
# (/app/data/secrets/stream-router.env). Bila diisi: minimal 32 karakter acak dan tidak boleh berubah;
# APP_ENCRYPTION_KEY yang berbeda membuat credential kamera terenkripsi tidak dapat dibuka.
AUTH_SECRET=
APP_ENCRYPTION_KEY=

# Nama aplikasi yang tampil di dashboard.
PUBLIC_APP_NAME=Camera Integration

# Lanjutan (opsional): hapus tanda # di depan baris untuk mengubah default container.
# auto = cookie login diberi atribut Secure hanya bila dashboard dibuka lewat HTTPS.
# COOKIE_SECURE=auto
# IP reverse proxy HTTPS di depan dashboard (false bila diakses langsung).
# TRUST_PROXY=false
# Origin tambahan yang boleh mengirim request ke API (akses langsung lewat IP LAN sudah diizinkan).
# CORS_ORIGIN=http://localhost:3000
# Nama host lain untuk membuka dashboard, mis. nama komputer Windows atau nama .local, dipisah koma
# tanpa http:// dan port. Akses lewat IP dan localhost selalu diterima; nama lain ditolak (421)
# untuk mencegah DNS rebinding.
# ALLOWED_HOSTS=PC-KAMERA,kamera.local
# LOG_LEVEL=info
