# Salin file ini menjadi .env. Jangan commit .env atau memakai nilai contoh di production.
# Generate kedua secret aman dan berbeda dengan Node.js:
#   npm run secrets:generate

# Runtime HTTP
NODE_ENV=development
HOST=127.0.0.1
# Port backend API. Tidak perlu dibuka langsung dari browser saat development.
# Proxy Vite otomatis meneruskan /api ke HOST dan PORT ini.
PORT=3000
# Port frontend Vite yang dibuka dari browser.
WEB_PORT=5173
LOG_LEVEL=info
# false bila API diakses langsung. true hanya mempercayai reverse proxy di host yang sama
# (127.0.0.1/::1); proxy di host lain ditulis sebagai IP/CIDR dipisah koma, mis. 10.0.0.5.
# Proxy wajib menimpa X-Forwarded-For (lihat docs/DEPLOYMENT.md).
TRUST_PROXY=false
# Harus sama dengan origin frontend (protokol, host, dan WEB_PORT).
CORS_ORIGIN=http://localhost:5173
# Production: hostname lain (tanpa skema dan port, dipisah koma) yang boleh dipakai membuka dashboard,
# mis. nama komputer atau nama .local. IP, localhost, host CORS_ORIGIN, dan MEDIAMTX_PUBLIC_HOST selalu
# diterima; Host lain ditolak 421 sebagai perlindungan DNS rebinding.
# ALLOWED_HOSTS=kamera.lan,PC-KAMERA
# Atribut Secure cookie login: auto | true | false. Tidak diisi = true saat NODE_ENV=production,
# selain itu false. auto = Secure hanya bila request datang lewat HTTPS (menghormati TRUST_PROXY);
# dipakai container Docker agar login lewat http://<IP-LAN>:3000 tetap berfungsi.
# COOKIE_SECURE=auto
PUBLIC_APP_NAME=Camera Integration

# Persistensi SQLite. Path ini relatif terhadap prisma/schema.prisma.
DATABASE_URL=file:../data/stream-router.db

# Binary media. `ffmpeg` berfungsi bila binary berada pada PATH di macOS/Linux.
# Linux: FFMPEG_PATH=/usr/bin/ffmpeg
# macOS Homebrew Apple Silicon: FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFMPEG_PATH=ffmpeg

# MediaMTX lokal. Binary development diunduh otomatis ke .runtime/.
MEDIAMTX_ENABLED=true
MEDIAMTX_VERSION=v1.19.2
# Port listener MediaMTX diatur dari Settings → MediaMTX & Recording, bukan dari .env.
MEDIAMTX_CONFIG_PATH=data/mediamtx/mediamtx.yml
# Host/IP publik default untuk URL WebRTC dan kandidat ICE bila Public host/IP di Settings kosong
# (nilai Settings yang diisi tetap menang). Tidak diisi atau kosong = deteksi otomatis IPv4 LAN;
# loopback (127.0.0.1) dipakai apa adanya untuk akses hanya dari komputer ini. Docker mengisinya
# dari HOST_LAN_IP.
# MEDIAMTX_PUBLIC_HOST=192.168.1.10
# Batas tunggu satu percobaan sampai source kamera mengirim media.
MEDIAMTX_READY_TIMEOUT_MS=15000
RECORDING_PATH=data/recordings

# Keamanan. Ganti seluruh nilai contoh ini sebelum production.
# AUTH_SECRET dan APP_ENCRYPTION_KEY minimal 32 karakter dan harus persisten.
AUTH_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER
APP_ENCRYPTION_KEY=GANTI_DENGAN_KEY_ACAK_MINIMAL_32_KARAKTER
ADMIN_USERNAME=admin
# Password bootstrap awal. Setelah database dibuat, ubah melalui Settings → Keamanan Akun.
# Perubahan dari GUI disimpan sebagai hash bcrypt di database dan tidak menulis ulang file .env.
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_KUAT
OPERATOR_PASSWORD=GANTI_DENGAN_PASSWORD_OPERATOR_KUAT

# Worker FFmpeg dan retry default
MAX_WORKERS=10
DEFAULT_RETRY_INITIAL_DELAY_MS=2000
DEFAULT_RETRY_MAX_DELAY_MS=60000
DEFAULT_MAX_RETRIES=10
FFMPEG_STOP_TIMEOUT_MS=10000

# Log
LOG_RETENTION_DAYS=7
MAX_LOG_LINES_PER_ROUTE=5000

# WebRTC fallback lama untuk Stream Route.
# Contoh: WEBRTC_ALLOWED_ORIGINS=https://media.example.com,https://webrtc.example.com
WEBRTC_ALLOWED_ORIGINS=

# Stream View langsung di browser (IFRAME/WHEP/YouTube/HLS/MJPEG/MP4).
# Kosong akan memakai WEBRTC_ALLOWED_ORIGINS sebagai fallback.
STREAM_VIEW_ALLOWED_ORIGINS=
# Development otomatis mengizinkan HTTP untuk stream LAN. Pada production,
# aktifkan hanya untuk sumber HTTP di LAN tepercaya. Aplikasi HTTPS tetap dapat
# diblokir browser saat mencoba memuat sumber HTTP (mixed content).
STREAM_VIEW_ALLOW_INSECURE_HTTP=false
